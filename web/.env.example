# WidgetWorks web — configuration is injected at BUILD TIME from the environment
# (locally: a git-ignored .env.local you create; in CI: GitHub Actions Variables/Secrets).
# NO real values are committed. Copy to .env.local for local dev.

# Base URL of the WidgetWorks API.
VITE_API_BASE_URL=http://localhost:5080

# Google OAuth *client id* (public — safe in the browser bundle; NOT a secret).
# Real value looks like 1234567890-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
