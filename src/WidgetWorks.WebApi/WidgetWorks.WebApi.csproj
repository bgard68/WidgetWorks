<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Enables `dotnet user-secrets` for LOCAL DEV. Secrets are stored outside the repo in the
         OS user profile (~/.microsoft/usersecrets/<id>/secrets.json) and loaded only in the
         Development environment. Dev-only by design — never used in production. See
         docs/local-development.md. -->
    <UserSecretsId>widgetworks-webapi-3d9a1f7c-2b84-4e15-9c60-8a5f0b2d6e41</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WidgetWorks.Application/WidgetWorks.Application.csproj" />
    <ProjectReference Include="../WidgetWorks.Infrastructure/WidgetWorks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Override transitive Microsoft.OpenApi 2.0.0 (GHSA-v5pm-xwqc-g5wc) with the patched 2.7.5. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
  </ItemGroup>

</Project>
