##############################################
# WidgetWorks .gitignore
# DevSecOps baseline — keep secrets, local state,
# AI/agent artifacts, logs, and cloud exports OUT.
##############################################

############################
# Secrets / credentials  🔒  (NEVER commit)
############################
# Environment files — the ONLY allowed one is *.env.example
.env
.env.*
!.env.example
*.env
!*.env.example
.env.local
.env.*.local

# Local app config overrides
appsettings.*.local.json
appsettings.Local.json
appsettings.Secrets.json
appsettings.*.Secrets.json
local.settings.json
secrets.json
**/secrets/*
!**/secrets/.gitkeep
*.secret
*.secrets

# Keys, certs, signing material
*.pem
*.key
*.pfx
*.p12
*.pkcs12
*.p8
*.jks
*.keystore
*.crt
*.cer
*.der
*.asc
*.gpg
*.snk
*.mobileprovision
id_rsa*
id_ed25519*
*.ppk

# Cloud / provider & tool credentials
.aws/
.azure/
gha-creds-*.json
azureauth.json
*.publishsettings
.vault-token
kubeconfig
*.kubeconfig
.kube/
.npmrc
!.npmrc.example
.pypirc
*.tfvars
!*.tfvars.example

############################
# AI / agent artifacts     🤖  (never publish)
############################
.claude/
.claude-*/
CLAUDE.local.md
.cursor/
.aider*
.continue/
*.conversation.json
conversations/
transcripts/
.chat/
.ai-logs/

############################
# Azure / IaC exports      ☁️
# Exports must NOT land in the repo. The retrieval
# script (scripts/**) is explicitly re-included below.
############################
infra/exports/
**/azure-export*.json
**/arm-export*.json
**/*.exported.json
exported-template*.json
template.json
parameters.json
*.armparam.json
*.bicepparam
!example.bicepparam
# Terraform state (contains secrets)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
# ...but ALWAYS keep the infra-retrieval script(s)
!scripts/**

############################
# Logs                     📄
############################
*.log
logs/
log/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
Seq/
serilog*.json
!serilog.example.json

############################
# .NET / Visual Studio
############################
bin/
obj/
out/
[Dd]ebug/
[Rr]elease/
x64/
x86/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
project.lock.json
artifacts/
BenchmarkDotNet.Artifacts/
*.received.*
# Test / coverage
[Tt]est[Rr]esults/
coverage/
*.coverage
*.coveragexml
*.trx
TestResults*.xml

############################
# Compiled binaries & build outputs  🧱
# Source-only repo — compiled output is never committed. These extension rules
# back up the bin/ and obj/ directory ignores above (belt-and-suspenders).
############################
*.dll
*.exe
*.pdb
*.obj
*.bin
*.nupkg
*.snupkg
[Pp]ublish/
**/[Pp]ublish/
app.publish/

############################
# Archives                 📦  (build/release bundles — don't commit)
############################
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.gz
*.rar

############################
# Node / React (Vite) front end
############################
node_modules/
dist/
build/
.vite/
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
.pnp.*

############################
# Docker / runtime
############################
*.pid
docker-compose.override.yml
.docker/
pgdata/
postgres-data/

############################
# OS / editor cruft
############################
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.idea/
*.iml
