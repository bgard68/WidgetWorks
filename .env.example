# WidgetWorks — example environment file.
# Copy to `.env` (git-ignored) and fill in LOCAL values.
# NEVER commit a real .env. CI + gitleaks + pre-commit will block secrets.
# For local dev, prefer `dotnet user-secrets` over .env where possible.
# Keys use the ASP.NET double-underscore convention (Section__Key).

# ── Database ──
POSTGRES_USER=widgetworks
POSTGRES_PASSWORD=replace-me-locally
POSTGRES_DB=widgetworks
# Non-Docker local runs can instead set a full connection string:
# ConnectionStrings__WidgetWorks=Host=localhost;Port=5432;Database=widgetworks;Username=widgetworks;Password=replace-me-locally

# ── JWT / auth ──
# Generate locally, e.g.:  openssl rand -base64 48
Jwt__SigningKey=replace-me-with-a-locally-generated-key
Jwt__Issuer=https://localhost:5001
Jwt__Audience=widgetworks-spa
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ── CORS / app ──
# Comma-separated browser origins allowed to call the API.
Cors__AllowedOrigins=http://localhost:3000,http://localhost:5173
# Public base URL of the SPA (used to build links in emails, e.g. password reset).
App__BaseUrl=http://localhost:3000

# ── Google OIDC (Sign in with Google) ──
# The client id is PUBLIC (not a secret). No client secret is used by the ID-token flow.
Google__ClientId=your-google-client-id.apps.googleusercontent.com

# ── Payments ──
# Which IPaymentGateway adapter to use: "Mock" (default) or "Stripe".
Payments__Provider=Mock
# Stripe TEST mode only — never live keys. Only needed when Payments__Provider=Stripe.
Payments__Stripe__SecretKey=sk_test_replace_me
Payments__Stripe__ApiBase=https://api.stripe.com

# ── Email ──
# "Dev" writes emails to the app log (default); "Smtp" sends for real.
Email__Provider=Dev
Email__Host=localhost
Email__Port=587
Email__Username=
Email__Password=replace-me-locally
# STARTTLS. Real providers need true; a local catcher (Mailpit on 1025) needs false.
Email__UseStartTls=true
Email__FromAddress=no-reply@widgetworks.demo
Email__FromName=WidgetWorks

# ── Web build (Vite) — public, injected at BUILD time ──
# In CI these come from GitHub Actions Variables; locally from web/.env.local or compose.
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Demo seed accounts (documented, throwaway — the sanctioned exception) ──
Seed__DemoAdminEmail=admin@widgetworks.demo
Seed__DemoAdminPassword=DemoAdmin!Change01
Seed__DemoCustomerEmail=demo@widgetworks.demo
Seed__DemoCustomerPassword=DemoUser!Change01
